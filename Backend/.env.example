# ProjectFlow Backend — Environment Variables
#
# Copy this file to `.env` in the Backend/ directory and fill in real values:
#   cp .env.example .env
#
# All variables are read via python-dotenv at process start (app/db/database.py,
# app/utils/security.py, app/utils/totp.py, app/services/email_service.py).

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — app/db/database.py
# The app connects using: postgresql+psycopg://USER:PASSWORD@HOST:PORT/NAME
# The database itself is created automatically on first startup if it does
# not already exist (the DB user needs CREATEDB privileges for that to work).
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=project_management

# ---------------------------------------------------------------------------
# JWT / Authentication — app/utils/security.py
# ---------------------------------------------------------------------------
# Secret key used to sign/verify access tokens (HS256). MUST be set to a long,
# random, secret value in any non-local environment — the code falls back to
# an insecure default if this is left blank, which is unsafe in production.
SECRET_KEY=change-this-to-a-long-random-secret

# How long an access token stays valid after login/register.
# Accepts a number + unit suffix: s/sec/seconds, m/min/minutes, h/hr/hours, d/day/days.
# Defaults to "1h" if unset or unparseable.
EXPIRY_TIME="1h"

# ---------------------------------------------------------------------------
# TOTP (password reset) — app/utils/totp.py
# Server-side secret used to derive each user's one-time password-reset code.
# It is combined with the user's id + current hashed password, so codes
# automatically become invalid once a user's password changes. Optional —
# falls back to a built-in default if unset, but set an explicit random value
# in production so reset codes can't be predicted from the public source code.
# ---------------------------------------------------------------------------
TOTP_SERVER_SECRET_KEY=change-this-to-a-long-random-secret

# ---------------------------------------------------------------------------
# SMTP / Email — app/services/email_service.py
# Used to send password-reset codes and task-assignment notifications.
# If SMTP_USER or SMTP_PASSWORD is left blank, the app does NOT fail — it
# falls back to printing the email contents to the console, which is useful
# for local development without real email credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address shown on outgoing emails.
SENDER_EMAIL=noreply@projectflow.com

# ---------------------------------------------------------------------------
# Application settings
# Base URL of the deployed frontend — used to build links inside emails
# (e.g. the "View Task Details" button links to {FRONTEND_URL}/tasks/{task_id}).
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# CORS
# Not configurable via environment variables today — app/main.py currently
# hardcodes an open CORS policy (allow_origins=["*"], all methods/headers
# allowed). Restricting this requires a code change, not an env var. Listed
# here only so it isn't missed when reviewing this file.
# ---------------------------------------------------------------------------
