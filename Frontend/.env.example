# ProjectFlow Frontend — Environment Variables
#
# Copy this file to `.env` in the Frontend/ directory and fill in real values:
#   cp .env.example .env
#
# NOTE: Vite only exposes variables prefixed with VITE_ to client-side code,
# and it bakes them into the JS bundle at BUILD time (not read at runtime).
# If you change this file after running `npm run build`, you must rebuild.

# Base URL of the backend API (see ../Backend/README.md).
# Used as the axios `baseURL` for every API request (src/services/api.js).
# Defaults to http://localhost:8000 in code if left unset, but it's best to
# set it explicitly for every environment (local, staging, production).
VITE_API_URL=http://localhost:8000
